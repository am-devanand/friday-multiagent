# LiveKit credentials (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq AI API key
GROQ_API_KEY=

# Sarvam AI API key (get from https://dashboard.sarvam.ai)
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# Deepgram API key (get from https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Google Cloud credentials (used when STT_PROVIDER = "google")
# Option 1 – path to a service-account JSON file (download from GCP Console → IAM → Service Accounts)
# Option 2 – leave blank and run: gcloud auth application-default login
# Make sure the "Cloud Speech-to-Text API" is enabled in your GCP project.
GOOGLE_APPLICATION_CREDENTIALS=

# Supabase configuration for ticketing system
SUPABASE_URL=https://your-project-id.supabase.co/rest/v1
SUPABASE_API_KEY=your-supabase-api-key

GOOGLE_API_KEY=you-google-api-key (from https://aistudio.google.com/projects)

# Honcho memory (get from https://app.honcho.dev)
HONCHO_API_KEY=
HONCHO_WORKSPACE=friday-multiagent

# ElevenLabs voice (get from https://elevenlabs.io)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Slack bot (get from https://api.slack.com/apps)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Telegram bot (get from @BotFather https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# BlueBubbles iMessage relay (self-hosted https://bluebubbles.io)
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free cloud brains (default: Gemini AI Studio free primary + OpenRouter :free fallback).
# No Ollama/Groq/local. GitHub Models (models.github.ai) is retired — do not use.
# Cerebras needs a card — do not use as default.
# GOOGLE_API_KEY above (get from https://aistudio.google.com -> Get API Key)
FREE_LLM_MODE=gemini
GEMINI_FREE_MODEL=gemini-2.5-flash-lite
# OpenRouter (get from https://openrouter.ai -> sk-or key; ':free' suffix required on model)
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
# opencode brain shim (FREE_LLM_MODE=opencode; needs brain/opencode_proxy.py running)
OPENCODE_PROXY_URL=http://127.0.0.1:8001/v1
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
